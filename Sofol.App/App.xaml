<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Sofol.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Sofol.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:BadgeBackgroundConverter x:Key="BadgeBackgroundConverter" />
            <converters:BadgeForegroundConverter x:Key="BadgeForegroundConverter" />
            <converters:StatusForegroundConverter x:Key="StatusForegroundConverter" />
            <converters:UndoneBadgeBackgroundConverter x:Key="UndoneBadgeBackgroundConverter" />
            <converters:UndoneBadgeForegroundConverter x:Key="UndoneBadgeForegroundConverter" />
            <converters:WatcherBadgeBackgroundConverter x:Key="WatcherBadgeBackgroundConverter" />
            <converters:WatcherBadgeForegroundConverter x:Key="WatcherBadgeForegroundConverter" />

            <!-- Phong cách Fluent Card chuẩn Windows 11 / WinUI Gallery -->
            <Style x:Key="FluentCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
