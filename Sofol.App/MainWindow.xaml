<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sofol.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sofol - Sắp xếp tệp thông minh">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom TitleBar chuẩn Windows 11 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="18,0,0,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image
                    Width="26"
                    Height="26"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Assets/AppLogo.png"
                    Stretch="Uniform" />
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Text="Sofol" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    Text="Trình Sắp Xếp Tệp Thông Minh cho Windows 11" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            ItemInvoked="OnNavItemInvoked"
            OpenPaneLength="235"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavSelectionChanged">

            <NavigationView.PaneHeader>
                <Button
                    x:Name="InlineBackButton"
                    Width="40"
                    Height="36"
                    Margin="0,2,0,2"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Quay lại"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnInlineBackClick"
                    CornerRadius="6"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Quay lại (Nút Back trên chuột hoặc Alt + Trái)">
                    <FontIcon FontSize="15" Glyph="&#xE72B;" />
                </Button>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Không gian dọn dẹp" Tag="watcher">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Lịch sử &amp; Hoàn tác" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator x:Name="WatchedFoldersSeparator" Visibility="Collapsed" />
                <NavigationViewItemHeader x:Name="WatchedFoldersHeader" Content="Thư mục theo dõi" Visibility="Collapsed" />
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Hướng dẫn" SelectsOnInvoked="False" Tag="guide">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavItem" Content="Cài đặt" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="GlobalUpdateBanner"
                    Grid.Row="0"
                    Margin="28,12,28,0"
                    Closed="OnGlobalUpdateBannerClosed"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Informational"
                    Title="Đã có bản cập nhật mới"
                    Visibility="Collapsed">
                    <InfoBar.ActionButton>
                        <Button
                            Click="OnOpenUpdateSettingsClick"
                            Content="Xem &amp; Cập nhật"
                            Style="{StaticResource AccentButtonStyle}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
