<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sofol.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Sofol.Core.Models">

    <Grid Padding="28,20,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Lịch sử &amp; Hoàn tác (Undo)"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Mỗi đợt dọn dẹp đều được ghi lại đầy đủ để bạn có thể khôi phục tệp về vị trí cũ chỉ với 1 cú nhấp chuột."
                TextWrapping="Wrap" />
        </StackPanel>

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.HistorySessions}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,0,0,10" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:OrganizationSession">
                    <Border Style="{StaticResource FluentCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="42"
                                Height="42"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <FontIcon FontSize="18" Glyph="&#xE81C;" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ExecutedAtDisplay}" />
                                    <Border
                                        Padding="8,2"
                                        Background="{x:Bind IsUndone, Converter={StaticResource UndoneBadgeBackgroundConverter}}"
                                        CornerRadius="10">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{x:Bind IsUndone, Converter={StaticResource UndoneBadgeForegroundConverter}}"
                                            Text="{x:Bind StatusDisplay}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind SourceFolderPath}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind SourceFolderPath}" />

                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap">
                                    <Run Text="Đã dọn " /><Run Text="{x:Bind MovedFileCount}" /><Run Text=" tệp • Tổng dung lượng: " /><Run Text="{x:Bind FormattedTotalSize}" />
                                </TextBlock>

                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="{x:Bind RuleBreakdownSummary}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind RuleBreakdownSummary}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <Button
                                    Click="OnViewDetailsClick"
                                    Content="Xem chi tiết"
                                    Tag="{x:Bind}" />
                                <Button
                                    Click="OnUndoSessionClick"
                                    IsEnabled="{x:Bind IsUndone, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Tag="{x:Bind}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                                        <TextBlock Text="Hoàn tác" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="1"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.HasNoHistory, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="42"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE81C;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Chưa có lịch sử dọn dẹp nào"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Khi bạn bấm 'Sắp xếp ngay', toàn bộ nhật ký di chuyển tệp sẽ xuất hiện tại đây."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
