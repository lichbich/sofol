<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sofol.App.Views.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Sofol.Core.Models"
    xmlns:vm="using:Sofol.App.ViewModels">

    <ScrollViewer
        Padding="28,20,28,28"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Stretch" Spacing="18">

            <!-- Breadcrumb 3 cấp chuẩn Windows 11 Settings -->
            <Grid ColumnSpacing="16" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button
                            Margin="-8,0,0,0"
                            Padding="8,2"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnBreadcrumbWorkspaceClick"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Quay lại Không gian dọn dẹp">
                            <TextBlock
                                FontSize="24"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Không gian dọn dẹp" />
                        </Button>
                        <FontIcon
                            Margin="2,4,2,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE76C;" />
                        <Button
                            Padding="8,2"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.OpenCurrentRuleFolderPreviewCommand}"
                            CornerRadius="6"
                            ToolTipService.ToolTip="Chuyển sang Xem trước &amp; Dọn dẹp cho thư mục này">
                            <TextBlock
                                FontSize="24"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.SelectedRuleTabFolderName, Mode=OneWay}" />
                        </Button>
                        <FontIcon
                            Margin="2,4,2,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE76C;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="Quy tắc sắp xếp" />
                    </StackPanel>

                    <TextBlock
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SelectedRuleTabFolderPath, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SelectedRuleTabFolderPath, Mode=OneWay}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        Command="{x:Bind ViewModel.OpenCurrentRuleFolderPreviewCommand}"
                        ToolTipService.ToolTip="Xem trước kết quả sắp xếp với bộ quy tắc này">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE890;" />
                            <TextBlock Text="Xem trước &amp; Dọn" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnRestoreDefaultsClick" Content="Khôi phục mặc định" />
                    <Button Click="OnAddRuleClick" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="Thêm quy tắc" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2 tùy chọn thông minh gọn nhẹ cho thư mục đang chọn -->
            <StackPanel Spacing="8">
                <!-- Thẻ 1: Gom cụm tệp giống tên -->
                <Border Padding="16,12" Style="{StaticResource FluentCardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="36"
                            Height="36"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <FontIcon FontSize="17" Glyph="&#xE945;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Gom cụm tệp giống tên"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Ví dụ: BaoCao_1.docx, BaoCao_2.docx → tự gom vào thư mục BaoCao"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.ToggleSmartGroupingAdvancedCommand}"
                            Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE713;" />
                                <TextBlock FontSize="12" Text="Tùy chọn nâng cao" />
                            </StackPanel>
                        </Button>

                        <ToggleSwitch
                            Grid.Column="3"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind ViewModel.EnablePrefixSimilarityGrouping, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!-- Tùy chọn nâng cao (thu gọn mặc định) -->
                <StackPanel
                    Margin="16,0,0,0"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsSmartGroupingAdvancedOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Padding="16,12" Style="{StaticResource FluentCardStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Số tệp tối thiểu tạo thư mục cụm"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Chỉ gom nhóm khi có ít nhất N tệp giống tên nhau (mặc định 2)."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <NumberBox
                                Grid.Column="1"
                                Width="150"
                                VerticalAlignment="Center"
                                Minimum="2"
                                Maximum="10"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.MinFilesForPrefixGroup, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Padding="16,12" Style="{StaticResource FluentCardStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Ngưỡng độ tương đồng tên (%)"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Tỷ lệ giống nhau giữa hai tên tệp (mặc định 80%)."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                                <Slider
                                    Width="150"
                                    Minimum="55"
                                    Maximum="95"
                                    StepFrequency="5"
                                    Value="{x:Bind ViewModel.SimilarityThresholdPercent, Mode=TwoWay}" />
                                <TextBlock
                                    Width="40"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold">
                                    <Run Text="{x:Bind ViewModel.SimilarityThresholdPercent, Mode=OneWay}" /><Run Text="%" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Padding="16,12" Style="{StaticResource FluentCardStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Đặt các cụm tên vào thư mục cha chung"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Ví dụ: Gom theo tên\BaoCao thay vì tạo trực tiếp ở thư mục gốc."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                                <TextBox
                                    Width="145"
                                    IsEnabled="{x:Bind ViewModel.UseDedicatedSmartRootFolder, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.PrefixGroupRootFolderName, Mode=TwoWay}" />
                                <ToggleSwitch
                                    MinWidth="0"
                                    IsOn="{x:Bind ViewModel.UseDedicatedSmartRootFolder, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Padding="16,12" Style="{StaticResource FluentCardStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Lồng cụm tên vào thư mục của quy tắc"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Tạo thư mục cụm lồng bên trong thư mục đích của quy tắc đã khớp (VD: Tài liệu\BaoCao)."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <ToggleSwitch
                                Grid.Column="1"
                                MinWidth="0"
                                VerticalAlignment="Center"
                                IsOn="{x:Bind ViewModel.GroupPrefixInsideCategory, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <HyperlinkButton
                        Click="OnOpenSmartGroupingGuideClick"
                        Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="13" Glyph="&#xE897;" />
                            <TextBlock FontSize="12.5" Text="Xem hình minh họa &amp; Mô phỏng 3 chế độ gom cụm" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>

                <!-- Thẻ 2: Gom theo Năm-Tháng -->
                <Border Padding="16,12" Style="{StaticResource FluentCardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="36"
                            Height="36"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <FontIcon FontSize="17" Glyph="&#xE787;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Gom theo Năm-Tháng (VD: 2026-11)"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Tự động xếp tệp vào thư mục tháng sửa đổi — rất phù hợp cho Ảnh và Video"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind ViewModel.EnableFolderMonthGrouping, Mode=TwoWay}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Danh sách quy tắc phân loại của thư mục đang chọn -->
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Danh sách quy tắc phân loại"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button Click="OnEnableAllRulesClick" Content="Bật tất cả" />
                        <Button Click="OnDisableAllRulesClick" Content="Tắt tất cả" />
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Rules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:OrganizationRule">
                            <Border
                                Margin="0,0,0,8"
                                Padding="16,12"
                                Style="{StaticResource FluentCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="40"
                                        Height="40"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8">
                                        <FontIcon
                                            FontSize="18"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="{x:Bind IconGlyph}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <Grid ColumnSpacing="8" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Name}"
                                                TextWrapping="Wrap"
                                                VerticalAlignment="Center" />
                                            <Border
                                                Grid.Column="1"
                                                Padding="8,2"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                CornerRadius="10">
                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="→ " /><Run Text="{x:Bind TargetFolderName}" />
                                                </TextBlock>
                                            </Border>
                                            <Border
                                                Grid.Column="2"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="10">
                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                    <Run Text="Ưu tiên #" /><Run Text="{x:Bind Priority}" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ExtensionsDisplay}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            TextWrapping="Wrap">
                                            <Run Text="Từ khóa: " /><Run Text="{x:Bind KeywordsDisplay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                        <ToggleSwitch
                                            IsOn="{x:Bind IsEnabled, Mode=OneWay}"
                                            MinWidth="0"
                                            Tag="{x:Bind Mode=OneTime}"
                                            Toggled="OnRuleToggled" />
                                        <Button
                                            Click="OnEditRuleClick"
                                            Tag="{x:Bind Mode=OneTime}"
                                            ToolTipService.ToolTip="Chỉnh sửa quy tắc">
                                            <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                        </Button>
                                        <Button
                                            Click="OnDeleteRuleClick"
                                            Tag="{x:Bind Mode=OneTime}"
                                            ToolTipService.ToolTip="Xóa quy tắc">
                                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
