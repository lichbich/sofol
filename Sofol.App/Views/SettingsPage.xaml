<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sofol.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer
        Padding="28,20,28,28"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Stretch" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Cài đặt chung"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Tùy chỉnh giao diện Windows 11, xử lý xung đột tệp và phân loại nâng cao."
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Giao diện -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Giao diện &amp; Trải nghiệm Windows 11" />

                <Border Padding="16,14" Style="{StaticResource FluentCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="36"
                            Height="36"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <FontIcon FontSize="17" Glyph="&#xE790;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Chế độ màu sắc (Theme)"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Chuyển đổi giữa chế độ Sáng, Tối hoặc đồng bộ tự động theo Windows 11."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ComboBox
                            Grid.Column="2"
                            Width="205"
                            VerticalAlignment="Center"
                            SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Theo hệ thống Windows" />
                            <ComboBoxItem Content="Sáng (Light)" />
                            <ComboBoxItem Content="Tối (Dark)" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Khởi động cùng Windows -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Khởi động &amp; Chạy ngầm cùng Windows" />

                <Border Padding="16,14" Style="{StaticResource FluentCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="36"
                            Height="36"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <FontIcon FontSize="17" Glyph="&#xE7E8;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Khởi động cùng Windows"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Tự động chạy Sofol ngay khi bật máy và đăng nhập vào Windows."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind ViewModel.RunAtWindowsStartup, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Padding="16,14" Style="{StaticResource FluentCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="36"
                            Height="36"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <FontIcon FontSize="17" Glyph="&#xE737;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Mở cửa sổ chính khi khởi động máy"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Mặc định tắt: khi bật máy, Sofol chỉ chạy gọn trong khay hệ thống (System Tray) mà không bung cửa sổ lên màn hình."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.RunAtWindowsStartup, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.ShowWindowOnWindowsStartup, Mode=TwoWay}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- An toàn & Xử lý tệp -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Xử lý tệp &amp; An toàn" />

                <Border Padding="16,14" Style="{StaticResource FluentCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="36"
                            Height="36"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <FontIcon FontSize="17" Glyph="&#xE8C8;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Khi tệp đích đã tồn tại"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Chọn cách xử lý khi thư mục đích đã có sẵn một tệp trùng tên."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ComboBox
                            Grid.Column="2"
                            Width="225"
                            VerticalAlignment="Center"
                            SelectedIndex="{x:Bind ViewModel.SelectedConflictIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Tự động đổi tên (1), (2)..." />
                            <ComboBoxItem Content="Bỏ qua không di chuyển" />
                            <ComboBoxItem Content="Ghi đè nếu tệp nguồn mới hơn" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Padding="16,14" Style="{StaticResource FluentCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="36"
                            Height="36"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <FontIcon FontSize="17" Glyph="&#xE7C3;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Gom riêng tệp có dung lượng lớn"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Chuyển các tệp nặng hơn mức này vào một thư mục riêng để bạn dễ quản lý dung lượng ổ đĩa."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                            <NumberBox
                                Width="156"
                                IsEnabled="{x:Bind ViewModel.EnableLargeFileIsolation, Mode=OneWay}"
                                Maximum="50000"
                                Minimum="10"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.LargeFileThresholdMB, Mode=TwoWay}" />
                            <ToggleSwitch
                                MinWidth="0"
                                IsOn="{x:Bind ViewModel.EnableLargeFileIsolation, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Padding="16,14" Style="{StaticResource FluentCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="36"
                            Height="36"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <FontIcon FontSize="17" Glyph="&#xE8B7;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Gom tệp chưa phân loại vào thư mục riêng"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12.5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Các tệp không thuộc quy tắc nào sẽ được chuyển vào thư mục này thay vì để lẫn ở thư mục gốc."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                            <TextBox
                                Width="135"
                                IsEnabled="{x:Bind ViewModel.MoveUnmatchedToOthers, Mode=OneWay}"
                                Text="{x:Bind ViewModel.OthersFolderName, Mode=TwoWay}" />
                            <ToggleSwitch
                                MinWidth="0"
                                IsOn="{x:Bind ViewModel.MoveUnmatchedToOthers, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Dữ liệu ứng dụng -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Dữ liệu ứng dụng" />

                <Border Padding="16,14" Style="{StaticResource FluentCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="36"
                            Height="36"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <FontIcon FontSize="17" Glyph="&#xE8B7;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Nơi lưu cài đặt và lịch sử hoàn tác"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.StorageDirectory}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="OnOpenStorageClick"
                            Content="Mở thư mục" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Cập nhật ứng dụng -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Cập nhật ứng dụng" />

                <Border Padding="16,14" Style="{StaticResource FluentCardStyle}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="36"
                                Height="36"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <FontIcon FontSize="17" Glyph="&#xE895;" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="Phiên bản Sofol" />
                                    <Border
                                        Padding="6,1"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind ViewModel.CurrentVersionBadgeText, Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    FontSize="12.5"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Kiểm tra và nhận các tính năng mới nhất cho ứng dụng."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="OnCheckUpdatesClick"
                                IsEnabled="{x:Bind ViewModel.IsCheckingForUpdate, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ProgressRing
                                        Width="14"
                                        Height="14"
                                        IsActive="{x:Bind ViewModel.IsCheckingForUpdate, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsCheckingForUpdate, Mode=OneWay}" />
                                    <FontIcon
                                        FontSize="13"
                                        Glyph="&#xE895;"
                                        Visibility="{x:Bind ViewModel.IsCheckingForUpdate, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    <TextBlock Text="Kiểm tra bản cập nhật" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="36" Height="1" />

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="Tự động kiểm tra bản cập nhật khi mở ứng dụng" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Tự động thông báo khi có phiên bản mới." />
                            </StackPanel>

                            <ToggleSwitch
                                Grid.Column="2"
                                MinWidth="0"
                                VerticalAlignment="Center"
                                IsOn="{x:Bind ViewModel.AutoCheckUpdatesOnStartup, Mode=TwoWay}" />
                        </Grid>

                        <!-- InfoBar thông báo trạng thái cập nhật -->
                        <InfoBar
                            IsOpen="{x:Bind ViewModel.IsUpdateInfoBarOpen, Mode=TwoWay}"
                            Message="{x:Bind ViewModel.UpdateInfoBarMessage, Mode=OneWay}"
                            Severity="{x:Bind ViewModel.UpdateInfoBarSeverity, Mode=OneWay}"
                            Title="{x:Bind ViewModel.UpdateInfoBarTitle, Mode=OneWay}">
                            <InfoBar.ActionButton>
                                <Button
                                    Click="OnApplyUpdateClick"
                                    Content="Cập nhật ngay"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind ViewModel.HasUpdateAvailable, Mode=OneWay}" />
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <!-- Thanh tiến trình tải bản cập nhật -->
                        <StackPanel
                            Spacing="6"
                            Visibility="{x:Bind ViewModel.IsDownloadingUpdate, Mode=OneWay}">
                            <ProgressBar
                                Maximum="1"
                                Minimum="0"
                                Value="{x:Bind ViewModel.UpdateProgressPercent, Mode=OneWay}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.UpdateProgressStatus, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
