<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sofol.App.Views.WatcherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28,20,28,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Tự động sắp xếp"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Theo dõi thư mục theo thời gian thực và tự động phân loại ngay sau khoảng thời gian trễ an toàn."
                TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.InfoBarTitle, Mode=OneWay}" />

        <!-- Thẻ trạng thái trực quan + Chọn thư mục theo dõi -->
        <Border Grid.Row="2" Style="{StaticResource FluentCardStyle}">
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="48"
                        Height="48"
                        VerticalAlignment="Center"
                        Background="{x:Bind ViewModel.IsWatcherRunning, Mode=OneWay, Converter={StaticResource WatcherBadgeBackgroundConverter}}"
                        CornerRadius="10">
                        <FontIcon
                            FontSize="22"
                            Foreground="{x:Bind ViewModel.IsWatcherRunning, Mode=OneWay, Converter={StaticResource WatcherBadgeForegroundConverter}}"
                            Glyph="&#xE7C4;" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <Border
                            HorizontalAlignment="Left"
                            Padding="10,3"
                            Background="{x:Bind ViewModel.IsWatcherRunning, Mode=OneWay, Converter={StaticResource WatcherBadgeBackgroundConverter}}"
                            CornerRadius="12">
                            <TextBlock
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind ViewModel.IsWatcherRunning, Mode=OneWay, Converter={StaticResource WatcherBadgeForegroundConverter}}"
                                Text="{x:Bind ViewModel.WatcherBadgeText, Mode=OneWay}" />
                        </Border>
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.WatcherStatusTitle, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.WatcherStatusText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button
                            AutomationProperties.Name="Bật tự động sắp xếp"
                            Command="{x:Bind ViewModel.ToggleWatcherCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsWatcherRunning, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE768;" />
                                <TextBlock Text="Bật tự động sắp xếp" />
                            </StackPanel>
                        </Button>

                        <Button
                            AutomationProperties.Name="Dừng tự động sắp xếp"
                            Command="{x:Bind ViewModel.ToggleWatcherCommand}"
                            Visibility="{x:Bind ViewModel.IsWatcherRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Foreground="#C42B1C" Glyph="&#xE71A;" />
                                <TextBlock Text="Dừng tự động sắp xếp" />
                            </StackPanel>
                        </Button>

                        <Button
                            AutomationProperties.Name="Dọn ngay"
                            Command="{x:Bind ViewModel.RunWatcherNowCommand}"
                            ToolTipService.ToolTip="Quét và dọn ngay các tệp hiện có mà không cần đợi hết độ trễ">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE945;" />
                                <TextBlock Text="Dọn ngay" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border
                    Padding="0,12,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Thư mục theo dõi:"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="1"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12.5"
                            Text="{x:Bind ViewModel.TargetFolderPath, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind ViewModel.TargetFolderPath, Mode=OneWay}"
                            VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button Click="OnBrowseFolderClick" Content="Đổi thư mục..." />
                            <Button Click="OnOpenFolderClick" Content="Mở Explorer" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Cấu hình độ trễ an toàn linh hoạt theo đơn vị thời gian -->
        <Border Grid.Row="3" Style="{StaticResource FluentCardStyle}" Padding="16,14">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8">
                    <FontIcon FontSize="17" Glyph="&#xE916;" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Độ trễ an toàn trước khi tự động dọn"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12.5"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Chọn đơn vị thời gian và nhập số lượng chờ sau khi tệp mới xuất hiện hoặc ngừng thay đổi kích thước."
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.WatcherDelaySummaryText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <NumberBox
                        Width="156"
                        Minimum="1"
                        Maximum="3650"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.AutoWatcherDelayValue, Mode=TwoWay}" />
                    <ComboBox
                        Width="132"
                        SelectedIndex="{x:Bind ViewModel.SelectedWatcherDelayUnitIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Theo giây" />
                        <ComboBoxItem Content="Theo phút" />
                        <ComboBoxItem Content="Theo giờ" />
                        <ComboBoxItem Content="Theo ngày" />
                        <ComboBoxItem Content="Theo tháng" />
                        <ComboBoxItem Content="Theo năm" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Nhật ký trực tiếp -->
        <Border Grid.Row="4" Style="{StaticResource FluentCardStyle}" Padding="0" MinHeight="180">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Padding="16,12"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Nhật ký sự kiện trực tiếp"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.ClearWatcherLogsCommand}"
                        Content="Xóa nhật ký" />
                </Grid>

                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.WatcherLogs}"
                    Padding="8"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Text="{x:Bind}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    Grid.Row="1"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6"
                    Visibility="{x:Bind ViewModel.HasNoWatcherLogs, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="36"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE9D5;" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Chưa có sự kiện nào. Hãy bật chế độ Tự động sắp xếp ở trên để theo dõi tự động."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
