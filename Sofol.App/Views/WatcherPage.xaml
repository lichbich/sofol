<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sofol.App.Views.WatcherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sofol.App.ViewModels">

    <ScrollViewer
        Padding="28,20,28,28"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Stretch" Spacing="16">

            <!-- Tiêu đề -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Không gian dọn dẹp"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Theo dõi tự động các thư mục của bạn — bấm vào một thư mục để xem trước và dọn dẹp thủ công."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.CreateDemoSandboxInWorkspaceCommand}"
                    ToolTipService.ToolTip="Tạo thư mục mẫu mô phỏng với 21 tệp để dùng thử ngay">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE945;" />
                        <TextBlock Text="Tạo thư mục Test mẫu" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.InfoBarTitle, Mode=OneWay}" />

            <!-- Thẻ điều khiển tổng gọn gàng -->
            <Border Style="{StaticResource FluentCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="48"
                        Height="48"
                        VerticalAlignment="Center"
                        Background="{x:Bind ViewModel.IsWatcherRunning, Mode=OneWay, Converter={StaticResource WatcherBadgeBackgroundConverter}}"
                        CornerRadius="10">
                        <FontIcon
                            FontSize="22"
                            Foreground="{x:Bind ViewModel.IsWatcherRunning, Mode=OneWay, Converter={StaticResource WatcherBadgeForegroundConverter}}"
                            Glyph="&#xE7C4;" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <Border
                            HorizontalAlignment="Left"
                            Padding="10,3"
                            Background="{x:Bind ViewModel.IsWatcherRunning, Mode=OneWay, Converter={StaticResource WatcherBadgeBackgroundConverter}}"
                            CornerRadius="12">
                            <TextBlock
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="{x:Bind ViewModel.IsWatcherRunning, Mode=OneWay, Converter={StaticResource WatcherBadgeForegroundConverter}}"
                                Text="{x:Bind ViewModel.WatcherBadgeText, Mode=OneWay}" />
                        </Border>
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.WatcherStatusTitle, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.WatcherStatusText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button
                            AutomationProperties.Name="Bật tự động"
                            Command="{x:Bind ViewModel.ToggleWatcherCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsWatcherRunning, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE768;" />
                                <TextBlock Text="Bật tự động" />
                            </StackPanel>
                        </Button>

                        <Button
                            AutomationProperties.Name="Tạm dừng"
                            Command="{x:Bind ViewModel.ToggleWatcherCommand}"
                            Visibility="{x:Bind ViewModel.IsWatcherRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Foreground="#C42B1C" Glyph="&#xE71A;" />
                                <TextBlock Text="Tạm dừng" />
                            </StackPanel>
                        </Button>

                        <Button
                            AutomationProperties.Name="Dọn tất cả ngay"
                            Command="{x:Bind ViewModel.RunWatcherNowCommand}"
                            ToolTipService.ToolTip="Dọn ngay tất cả thư mục đang bật">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE945;" />
                                <TextBlock Text="Dọn tất cả ngay" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Danh sách thư mục theo dõi + Thanh thêm nhanh -->
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Thư mục theo dõi" />

                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="OnAddCustomFolderClick"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="Thêm thư mục..." />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Hàng nút thêm nhanh 1 chạm -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Thêm nhanh:" />
                    <Button Click="OnQuickAddFolderClick" Padding="10,5" FontSize="12" Tag="Downloads">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE896;" />
                            <TextBlock Text="+ Downloads" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnQuickAddFolderClick" Padding="10,5" FontSize="12" Tag="Desktop">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE7F4;" />
                            <TextBlock Text="+ Desktop" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnQuickAddFolderClick" Padding="10,5" FontSize="12" Tag="Pictures">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE91B;" />
                            <TextBlock Text="+ Pictures" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnQuickAddFolderClick" Padding="10,5" FontSize="12" Tag="Videos">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE714;" />
                            <TextBlock Text="+ Videos" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnQuickAddFolderClick" Padding="10,5" FontSize="12" Tag="Documents">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE8A5;" />
                            <TextBlock Text="+ Documents" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Thẻ từng thư mục dạng 1 dòng gọn gàng -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.WatchedFolderItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WatchedFolderItemViewModel">
                            <Border
                                Margin="0,0,0,8"
                                Padding="16,12"
                                Style="{StaticResource FluentCardStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnPreviewFolderClick"
                                        CornerRadius="6"
                                        Margin="-8,-6,0,-6"
                                        Padding="8,6"
                                        Tag="{x:Bind Mode=OneTime}"
                                        ToolTipService.ToolTip="Bấm để xem trước và dọn dẹp thư mục này">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Width="40"
                                                Height="40"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8">
                                                <FontIcon
                                                    FontSize="18"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Glyph="{x:Bind IconGlyph, Mode=OneWay}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind DisplayName, Mode=OneWay}"
                                                        VerticalAlignment="Center" />
                                                    <Border
                                                        Padding="8,2"
                                                        VerticalAlignment="Center"
                                                        Background="{x:Bind IsActivelyWatching, Mode=OneWay, Converter={StaticResource WatcherBadgeBackgroundConverter}}"
                                                        CornerRadius="10">
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{x:Bind IsActivelyWatching, Mode=OneWay, Converter={StaticResource WatcherBadgeForegroundConverter}}"
                                                            Text="{x:Bind StatusBadgeText, Mode=OneWay}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextTrimming="CharacterEllipsis">
                                                    <Run Text="{x:Bind FolderPath, Mode=OneTime}" /><Run Text="  •  " /><Run Text="{x:Bind ActiveRulesSummaryText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                        <ComboBox
                                            Width="142"
                                            SelectedIndex="{x:Bind DelayPresetIndex, Mode=TwoWay}"
                                            ToolTipService.ToolTip="Thời gian chờ trước khi tự động sắp xếp tệp mới">
                                            <ComboBoxItem Content="Chờ 30 giây" />
                                            <ComboBoxItem Content="Chờ 1 phút" />
                                            <ComboBoxItem Content="Chờ 5 phút" />
                                            <ComboBoxItem Content="Chờ 15 phút" />
                                            <ComboBoxItem Content="Chờ 30 phút" />
                                            <ComboBoxItem Content="Chờ 1 giờ" />
                                            <ComboBoxItem Content="Chờ 6 giờ" />
                                            <ComboBoxItem Content="Chờ 1 ngày" />
                                            <ComboBoxItem Content="Chờ 3 ngày" />
                                            <ComboBoxItem Content="Chờ 7 ngày" />
                                            <ComboBoxItem Content="Chờ 30 ngày" />
                                        </ComboBox>

                                        <Button
                                            Click="OnOpenFolderRulesClick"
                                            Padding="10,6"
                                            Tag="{x:Bind Mode=OneTime}"
                                            ToolTipService.ToolTip="Xem và chỉnh sửa danh sách quy tắc của thư mục này">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="13" Glyph="&#xE71C;" />
                                                <TextBlock FontSize="12.5" Text="Quy tắc" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Padding="8,6"
                                            ToolTipService.ToolTip="Tác vụ khác">
                                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem
                                                        Click="OnRunFolderNowClick"
                                                        Tag="{x:Bind Mode=OneTime}"
                                                        Text="Dọn ngay thư mục này">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE945;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem
                                                        Click="OnPreviewFolderClick"
                                                        Tag="{x:Bind Mode=OneTime}"
                                                        Text="Xem trước kết quả">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE890;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem
                                                        Click="OnOpenSingleFolderClick"
                                                        Tag="{x:Bind Mode=OneTime}"
                                                        Text="Mở trong Explorer">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8A7;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem
                                                        Click="OnRemoveWatchedFolderClick"
                                                        Tag="{x:Bind Mode=OneTime}"
                                                        Text="Xóa khỏi danh sách">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>

                                        <ToggleSwitch
                                            MinWidth="0"
                                            Margin="2,0,0,0"
                                            IsOn="{x:Bind IsEnabled, Mode=OneWay}"
                                            Tag="{x:Bind Mode=OneTime}"
                                            Toggled="OnFolderEnabledToggled" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Trạng thái chưa có thư mục nào -->
                <Border
                    Padding="24"
                    Style="{StaticResource FluentCardStyle}"
                    Visibility="{x:Bind ViewModel.HasNoWatchedFolders, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="34"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8B7;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Chưa có thư mục nào trong danh sách theo dõi" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Hãy bấm các nút + Downloads, + Pictures... hoặc 'Thêm thư mục...' ở trên để bắt đầu."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Nhật ký trực tiếp -->
            <Border Style="{StaticResource FluentCardStyle}" Padding="0" MinHeight="190">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Padding="16,12"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Nhật ký sự kiện trực tiếp"
                            TextWrapping="Wrap" />
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.ClearWatcherLogsCommand}"
                            Content="Xóa nhật ký" />
                    </Grid>

                    <ListView
                        Grid.Row="1"
                        MaxHeight="240"
                        ItemsSource="{x:Bind ViewModel.WatcherLogs}"
                        Padding="8"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="12"
                                    Text="{x:Bind Mode=OneTime}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        Grid.Row="1"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        Visibility="{x:Bind ViewModel.HasNoWatcherLogs, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="34"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE9D5;" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Chưa có sự kiện nào. Hãy bật chế độ Tự động sắp xếp ở trên để theo dõi tự động."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
